#!/bin/bash
# Usage: quiet-run NEW_LOG_PATH -- COMMAND [ARG ...]
# For noninteractive commands only. Summary extraction is best effort.
umask 077
if [ "$#" -lt 3 ] || [ "$2" != "--" ]; then
  echo 'Usage: quiet-run NEW_LOG_PATH -- COMMAND [ARG ...]' >&2
  exit 64
fi
quiet_log=$1
shift 2
set -o noclobber
if ! exec 3> "$quiet_log"; then
  echo 'Cannot create a new log; refusing to run command.' >&2
  exit 73
fi
set +o noclobber
"$@" >&3 2>&1
quiet_status=$?
exec 3>&-
printf 'exit=%s log=%s\n' "$quiet_status" "$quiet_log"
if [ "$quiet_status" -eq 0 ]; then
  # Count lines differ across test frameworks. Never infer counts that are absent.
  /usr/bin/grep -Ei 'Tests:|Tests run:|Test Suites:|[0-9]+ (passed|failed|skipped|pending|tests passed)|BUILD SUCCESS|BUILD SUCCESSFUL' "$quiet_log" | /usr/bin/tail -20
  echo 'Summary extraction is best effort; inspect saved log for complete counts when needed.'
else
  /bin/cat "$quiet_log"
fi
exit "$quiet_status"
